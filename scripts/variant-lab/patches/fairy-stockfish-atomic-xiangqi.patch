+// atomic-xiangqi patch: the points a blast at s reaches, per variant.
+inline Bitboard Position::blast_squares(Square s) const {
+  assert(var != nullptr);
+  switch (var->blastShape)
+  {
+  case BLAST_WAZIR:
+      return attacks_bb<WAZIR>(s);
+  case BLAST_LINES:
+  {
+      // Wazir everywhere; a diagonal only where a xiangqi palace draws one,
+      // which is between a palace corner and its centre (files d-f, ranks 1-3
+      // and 8-10 on a 9x10 board). Any other board gets the wazir mask.
+      Bitboard diag = 0;
+#ifdef LARGEBOARDS
+      if (max_file() == FILE_I && max_rank() == RANK_10 && file_of(s) >= FILE_D && file_of(s) <= FILE_F)
+      {
+          Rank r = rank_of(s);
+          Rank centreRank = r <= RANK_3 ? RANK_2 : r >= RANK_8 ? RANK_9 : RANK_NB;
+          if (centreRank != RANK_NB)
+          {
+              Square centre = make_square(FILE_E, centreRank);
+              if (s == centre)
+                  diag = attacks_bb<FERS>(s);
+              else if (attacks_bb<FERS>(s) & centre)
+                  diag = square_bb(centre);
+          }
+      }
+#endif
+      return attacks_bb<WAZIR>(s) | diag;
+  }
+  default:
+      return attacks_bb<KING>(s);
+  }
+}
+
+// atomic-xiangqi patch: pieces a blast never removes.
+inline Bitboard Position::blast_immune_pieces() const {
+  Bitboard immune = pieces(PAWN);
+  for (PieceSet ps = blast_immune_types(); ps;)
+      immune |= pieces(pop_lsb(ps));
+  return immune;
+}
+
+
 inline PieceSet Position::mutually_immune_types() const {
   assert(var != nullptr);
   return var->mutuallyImmuneTypes;
