{
  "name": "mistboard",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run db:up && npm run db:migrate && npm run dev:persistent",
    "dev:persistent": "node scripts/dev.mjs",
    "dev:memory": "node scripts/dev.mjs --memory",
    "dev:lab": "npm run db:up && npm run db:migrate && node scripts/dev.mjs --lab",
    "dev:lab:memory": "node scripts/dev.mjs --lab --memory",
    "dev:web:agent": "npm run dev:agent --workspace @mistboard/web",
    "db:up": "node scripts/ensure-postgres.mjs",
    "db:migrate": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run migrate --workspace @mistboard/server",
    "db:seed:profiles": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:profiles --workspace @mistboard/server",
    "db:seed:watch": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:watch --workspace @mistboard/server",
    "db:seed:qa-fixtures": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:qa-fixtures --workspace @mistboard/server",
    "db:seed:qa": "npm run db:migrate && npm run db:seed:profiles && npm run db:seed:variant-fixtures && npm run db:seed:watch && npm run db:seed:qa-fixtures",
    "generate:variant-fixtures": "npm run generate:variant-fixtures --workspace @mistboard/server",
    "variant:catalog": "tsx scripts/variant-catalog.ts",
    "videos:audit": "node scripts/videos-audit.mjs",
    "videos:mine": "node scripts/videos-mine.mjs",
    "db:seed:variant-corpus": "node scripts/seed-variant-corpus.mjs",
    "db:seed:variant-fixtures": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:variant-fixtures --workspace @mistboard/server",
    "db:seed:variant-fixtures:lab": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run seed:variant-fixtures --workspace @mistboard/server -- --profile lab",
    "db:import:xiangqi-broadcast": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run import:xiangqi-broadcast --workspace @mistboard/server --",
    "db:poll:xiangqi-broadcast": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run poll:xiangqi-broadcast --workspace @mistboard/server --",
    "db:simulate:xiangqi-broadcast": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run simulate:xiangqi-broadcast --workspace @mistboard/server --",
    "source:xiangqi-broadcast": "npm run source:xiangqi-broadcast --workspace @mistboard/server --",
    "db:test:ensure": "node scripts/ensure-test-database.mjs",
    "test:persistent": "node scripts/run-persistent-tests.mjs",
    "smoke:xiangqi-broadcast": "node scripts/xiangqi-broadcast-local-smoke.mjs",
    "build": "node scripts/build.mjs",
    "build:all": "npm run build --workspaces",
    "start": "node scripts/start.mjs",
    "engine:enqueue": "npm run engine:enqueue --workspace=@mistboard/server",
    "engine:enqueue-smoke": "npm run engine:enqueue-smoke --workspace=@mistboard/server",
    "engine:enqueue-tournament": "npm run engine:enqueue-tournament --workspace=@mistboard/server",
    "engine:bot-rating-import": "npm run engine:bot-rating-import --workspace=@mistboard/server",
    "engine:bot-rating-promote": "npm run engine:bot-rating-promote --workspace=@mistboard/server",
    "engine:bot-rating-snapshots": "npm run engine:bot-rating-snapshots --workspace=@mistboard/server",
    "engine:elo-report": "npm run engine:elo-report --workspace=@mistboard/server",
    "engine:queue-status": "npm run engine:queue-status --workspace=@mistboard/server",
    "engine:tournament-status": "npm run engine:tournament-status --workspace=@mistboard/server",
    "ops:test-engine-alert": "npm run ops:test-engine-alert --workspace=@mistboard/server --",
    "worker": "npm run worker --workspace=@mistboard/server",
    "worker:execute": "npm run worker:execute --workspace=@mistboard/server",
    "worker:service": "npm run worker:service --workspace=@mistboard/server",
    "worker:dev": "npm run worker:dev --workspace=@mistboard/server",
    "worker:dev:execute": "npm run worker:dev:execute --workspace=@mistboard/server",
    "worker:dev:service": "npm run worker:dev:service --workspace=@mistboard/server",
    "engine:artifact-archive": "node scripts/archive-engine-artifact.mjs",
    "engine:artifact-audit": "node scripts/engine-artifact-audit.mjs",
    "engine:artifact-closeout": "node scripts/engine-artifact-closeout.mjs",
    "engine:budget-report": "node scripts/engine-budget-report.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:tooling && npm run test:unit --workspaces --if-present",
    "test:parked": "npm run test:parked --workspaces --if-present",
    "test:tooling": "node --test scripts/*.test.mjs && tsx --test scripts/*.test.ts scripts/variant-lab/*.test.ts",
    "test:puzzles:corpus": "npm run test:puzzles:corpus --workspace @mistboard/game",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check:cycles": "madge --circular --extensions ts apps packages",
    "agent:scan": "node scripts/agent-scan.mjs",
    "og:preview": "node scripts/og-preview.mjs",
    "gate:evidence": "node scripts/gate-evidence.mjs",
    "check:drift": "node scripts/drift-check.mjs",
    "variants": "node scripts/variant-status.mjs",
    "news:tweet": "node scripts/announce-tweet.mjs",
    "i18n:check": "npm run i18n:check --workspace @mistboard/web --",
    "i18n:coverage": "npm run i18n:coverage --workspace @mistboard/web --",
    "i18n:prune-articles": "npm run i18n:prune --workspace @mistboard/web",
    "index:fix": "node scripts/drift-check.mjs --only index --fix",
    "check:jungle-art": "node scripts/check-jungle-art.mjs",
    "publish:jungle-art": "node scripts/publish-jungle-art.mjs",
    "worktree:new": "node scripts/worktree-new.mjs",
    "worktree:prepare": "node scripts/worktree-prepare.mjs",
    "verify": "node scripts/verify.mjs",
    "ci:quick": "node scripts/ci-checks.mjs quick",
    "ci:local": "node scripts/ci-checks.mjs local",
    "ci:browser-smoke:plan": "node scripts/ci-browser-smoke-plan.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "visual:check": "node scripts/visual-check.mjs",
    "mobile:loop": "node scripts/mobile-loop.mjs",
    "test:e2e:smoke": "npm run visual:check",
    "test:auth:local": "node scripts/auth-nav-smoke.mjs",
    "test:study:persistent": "node scripts/study-creator-persistent-smoke.mjs",
    "test:dark-xiangqi:persistent": "npm run test:dark-xiangqi:persistent --workspace @mistboard/web",
    "test:xiangqi-broadcast": "npm run test:xiangqi-broadcast --workspace @mistboard/game",
    "test:mobile:shots": "npm run mobile:loop",
    "engine:capture-beliefs": "node scripts/capture-belief-artifacts.mjs",
    "puzzles:mine:mini-xiangqi": "tsx scripts/variant-lab/mini-xiangqi-puzzle-miner.ts",
    "mine:remainder": "node scripts/mine-remainder.mjs",
    "pilot:elephantchess-worker": "tsx scripts/variant-lab/elephantchess-pilot-worker.ts",
    "pilot:elephantchess-audit": "tsx scripts/variant-lab/elephantchess-pilot-audit-worker.ts",
    "pilot:elephantchess-status": "npm run pilot:elephantchess-status --workspace @mistboard/server --",
    "pilot:elephantchess-quality": "npm run pilot:elephantchess-quality --workspace @mistboard/server --",
    "readout:mistboard": "npm run readout:mistboard --workspace @mistboard/server --",
    "pilot:elephantchess-review:export": "npm run pilot:elephantchess-review:export --workspace @mistboard/server --",
    "pilot:elephantchess-publish": "npm run pilot:elephantchess-publish --workspace @mistboard/server --",
    "release:local-smoke": "node scripts/release-local-smoke.mjs",
    "release:prod": "node scripts/release-prod.mjs",
    "deploy:engine-worker": "node scripts/deploy-engine-worker.mjs",
    "prod:smoke:plan": "node scripts/prod-smoke-plan.mjs",
    "prod:wait-revision": "node scripts/wait-prod-revision.mjs",
    "prod:smoke:lite": "node scripts/prod-lite-smoke.mjs",
    "prod:smoke:correspondence": "node scripts/prod-correspondence-smoke.mjs",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "prod:smoke:engines": "node scripts/prod-engine-smoke.mjs",
    "prod:smoke:dmx": "node scripts/prod-dmx-smoke.mjs",
    "prod:smoke:dxq": "node scripts/prod-dxq-smoke.mjs",
    "prod:smoke:fortress": "node scripts/prod-fortress-smoke.mjs",
    "prod:smoke:banqi": "node scripts/prod-banqi-smoke.mjs",
    "prod:smoke:jieqi": "node scripts/prod-jieqi-smoke.mjs",
    "prod:smoke:jungle": "node scripts/prod-jungle-smoke.mjs",
    "prod:smoke:jungle-flip": "node scripts/prod-jungle-flip-smoke.mjs",
    "prod:smoke:xiangqi": "node scripts/prod-xiangqi-smoke.mjs",
    "prod:smoke:engine-playout": "node scripts/prod-engine-playout.mjs",
    "prod:smoke:ceval": "node scripts/prod-ceval-smoke.mjs",
    "prod:smoke:practice": "node scripts/check-practice-catalog.mjs",
    "time:command": "node scripts/time-command.mjs",
    "research:kqk-belief": "tsx scripts/fow-kqk-belief.ts",
    "jieqi:play": "tsx scripts/jieqi-playthrough.ts",
    "reveal-chess:play": "tsx scripts/reveal-chess-playthrough.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "shell-quote": "^1.9.0",
    "brace-expansion": "^5.0.9",
    "serve-handler": {
      "minimatch": {
        "brace-expansion": "^5.0.9"
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.62.1",
    "concurrently": "10.0.5",
    "madge": "8.0.0",
    "opentype.js": "^2.0.0"
  }
}
