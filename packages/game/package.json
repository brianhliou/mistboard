{
  "name": "@mistboard/game",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./puzzle-seed": {
      "types": "./dist/puzzle-seed.d.ts",
      "default": "./dist/puzzle-seed.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "test:unit": "tsx --test --test-concurrency=4 src/**/*.test.ts",
    "test:parked": "tsx --test --test-concurrency=4 'src/**/*.parkedtest.ts'",
    "test:puzzles:corpus": "tsx --test src/**/*.slowtest.ts",
    "test:xiangqi-broadcast": "tsx --test src/xiangqi-broadcast.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chessops": "^0.15.1",
    "elephantops": "^0.1.1"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
