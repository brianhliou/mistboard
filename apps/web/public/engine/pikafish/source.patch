+#ifdef __EMSCRIPTEN__
+namespace {
+std::unique_ptr<UCIEngine> wasmUci;
+}
+
+extern "C" {
+
+// Builds the engine once. Call after the NNUE file is in the module's
+// filesystem so the default EvalFile load succeeds, or follow with
+// `setoption name EvalFile value /path/to/pikafish.nnue`.
+EMSCRIPTEN_KEEPALIVE
+void pikafish_initialize() {
+    if (wasmUci)
+        return;
+    std::cout << engine_info() << std::endl;
+    Attacks::init();
+    Position::init();
+    static char  program[] = "/pikafish";
+    static char* argv[]    = {program, nullptr};
+    wasmUci = std::make_unique<UCIEngine>(CommandLine(1, argv));
+    Tune::init(wasmUci->engine_options());
+}
+
+// One UCI command line, exactly as it would be typed on stdin. `go` returns
+// as soon as the search threads are started; output arrives through stdout.
+EMSCRIPTEN_KEEPALIVE
+void pikafish_command(const char* command) {
+    if (wasmUci && command)
+        wasmUci->execute(command);
+}
+
+}
+#endif
+
 #ifdef UNIVERSAL_BINARY
 }  // namespace Stockfish
 
