-// Returns the inverse of a permutation
-template<usize Len>
-constexpr std::array<usize, Len> invert_permutation(const std::array<usize, Len>& order) {
-    std::array<usize, Len> inverse{};
-    for (usize i = 0; i < order.size(); i++)
-        inverse[order[i]] = i;
-    return inverse;
-}
