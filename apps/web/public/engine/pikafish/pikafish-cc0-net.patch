+// Debug commands run synchronously with search stopped. They also work in check.
+void Engine::nnue_raw() const {
+    verify_network();
+    auto stack = std::make_unique<NN::AccumulatorStack>();
+    auto cache = std::make_unique<NN::AccumulatorCaches>(*network);
+    sync_cout << "NNUE raw " << network->raw(pos, *stack, *cache) << sync_endl;
+}
+
+void Engine::nnue_check(int games, int plies, unsigned seed) const {
+    verify_network();
+    if (games < 1 || games > 1000 || plies < 1 || plies > MAX_PLY - 1)
+        nnue_failure("nnuecheck: games 1..1000, plies 1..245");
+    auto stack = std::make_unique<NN::AccumulatorStack>();
+    auto cache = std::make_unique<NN::AccumulatorCaches>(*network);
+#ifdef NDEBUG
+    sync_cout << "NNUE check build=release" << sync_endl;
+#else
+    sync_cout << "NNUE check build=debug" << sync_endl;
+#endif
+    std::mt19937 rng(seed);
+    u64 checks = 0, moves = 0, captures = 0, kings = 0, nulls = 0;
+    auto check = [&](const Position& p) {
+        if (!network->check_accumulator(p, *stack, *cache))
+            nnue_failure("NNUE accumulator mismatch: " + p.fen());
+        ++checks;
+    };
+    for (int game = 0; game < games; ++game) {
+        Position p;
+        std::deque<StateInfo> gameStates(1);
+        if (auto err = p.set(pos.fen(), &gameStates.back()))
+            nnue_failure(err->what());
+        stack->reset();
+        check(p);
+        std::vector<Move> played;
+        for (int ply = 0; ply < plies; ++ply) {
+            MoveList<LEGAL> legal(p);
+            if (legal.size() == 0) break;
+            Move m = legal.begin()[rng() % legal.size()];
+            captures += p.capture(m);
+            kings += type_of(p.moved_piece(m)) == KING;
+            gameStates.emplace_back();
+            auto& dirties = stack->push();
+            p.do_move(m, gameStates.back(), p.gives_check(m), dirties, nullptr, nullptr);
+            played.push_back(m); ++moves;
+            check(p);
+            if (ply % 19 == 0)
+                sync_cout << "NNUE sample " << p.fen() << sync_endl;
+            if (!p.checkers() && ply % 17 == 0) {
+                StateInfo nullState;
+                p.do_null_move(nullState); check(p);
+                p.undo_null_move(); check(p); ++nulls;
+            }
+        }
+        // Undo all the way to the root; cached child entries must not leak into parents.
+        while (!played.empty()) {
+            p.undo_move(played.back()); stack->pop();
+            played.pop_back(); gameStates.pop_back(); check(p);
+        }
+        // Replay with evaluations deferred for multiple plies, as in real search.
+        for (int ply = 0; ply < plies; ++ply) {
+            MoveList<LEGAL> legal(p);
+            if (!legal.size()) break;
+            Move m = legal.begin()[rng() % legal.size()];
+            gameStates.emplace_back();
+            auto& dirties = stack->push();
+            p.do_move(m, gameStates.back(), p.gives_check(m), dirties, nullptr, nullptr);
+            played.push_back(m);
+            if (ply % 11 == 10) check(p);
+        }
+        check(p);
+        while (!played.empty()) {
+            p.undo_move(played.back()); stack->pop();
+            played.pop_back(); gameStates.pop_back();
+            if (played.size() % 7 == 0) check(p);
+        }
+    }
+    sync_cout << "NNUE check passed games=" << games << " moves=" << moves
+              << " checks=" << checks << " captures=" << captures << " kings=" << kings
+              << " nulls=" << nulls << sync_endl;
+}
