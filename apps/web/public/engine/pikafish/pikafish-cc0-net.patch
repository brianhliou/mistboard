+    PSQFeatureSet::IndexList removed, added;
+    PSQFeatureSet::append_changed_indices(pos.king_square(p), a.dirtyPiece, p, removed, added);
+    for (auto idx : removed) apply(side, ft, idx, -1);
+    for (auto idx : added) apply(side, ft, idx, 1);
+    a.computed[p] = true;
