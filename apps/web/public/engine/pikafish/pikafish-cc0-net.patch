+// Definition of input features HalfKAv2_xq of NNUE evaluation function
+
+#include "half_ka_v2_xq.h"
+
+#include "../../position.h"
+
+namespace Stockfish::Eval::NNUE::Features {
+
+  // Index of a feature for a given king position and another piece on some square
+  IndexType HalfKAv2_xq::make_index(Color perspective, Square s, Piece pc, Square ksq) {
+    return IndexType(Orient[perspective][s] + PieceSquareIndex[perspective][pc] + PS_NB * KingBuckets[ksq]);
+  }
+
+  // Get a list of indices for active features
+  void HalfKAv2_xq::append_active_indices(
+    const Position& pos,
+    Color perspective,
+    IndexList& active
+  ) {
+    Square ksq = pos.king_square(perspective);
+    Bitboard bb = pos.pieces();
+    while (bb)
+    {
+      Square s = pop_lsb(bb);
+      active.push_back(make_index(perspective, s, pos.piece_on(s), ksq));
+    }
+  }
+
+
+  // append_changed_indices() : get a list of indices for recently changed features
+
+  void HalfKAv2_xq::append_changed_indices(
+    Square ksq,
+    const DirtyPiece& dp,
+    Color perspective,
+    IndexList& removed,
+    IndexList& added
+  ) {
+    removed.push_back(make_index(perspective, dp.from, dp.pc, ksq));
+    if (dp.to != SQ_NONE)
+      added.push_back(make_index(perspective, dp.to, dp.pc, ksq));
+    if (dp.remove_sq != SQ_NONE)
+      removed.push_back(make_index(perspective, dp.remove_sq, dp.remove_pc, ksq));
+  }
+
+  IndexType HalfKAv2_xq::make_layer_stack_bucket(const Position& pos) {
+    return std::min((pos.count<ALL_PIECES>() - 1) * 8 / 32, 7);
+  }
+
+  bool HalfKAv2_xq::requires_refresh(const DirtyPiece& dp, Color perspective) {
+    return dp.pc == make_piece(perspective, KING);
+  }
+
+}  // namespace Stockfish::Eval::NNUE::Features
