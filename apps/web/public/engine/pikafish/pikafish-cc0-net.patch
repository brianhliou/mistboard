+        PSQFeatureSet::IndexList active;
+        PSQFeatureSet::append_active_indices(pos, p, active);
+        for (auto idx : active) {
+            for (IndexType j = 0; j < L1; ++j)
+                full[j] += featureTransformer.weights[idx * L1 + j];
+            for (IndexType j = 0; j < PSQTBuckets; ++j)
+                psqt[j] += featureTransformer.psqtWeights[idx * PSQTBuckets + j];
+        }
+        for (IndexType j = 0; j < L1; ++j)
+            if (full[j] != a.accumulation[p][j]) return false;
+        if (psqt != a.psqtAccumulation[p]) return false;
+    }
+    return true;
