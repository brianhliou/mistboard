+void AccumulatorStack::update(Color p, const Position& pos, const FeatureTransformer& ft,
+                              usize from, usize to) noexcept {
+    auto& a = accumulators[to];
+    const auto& prev = accumulators[from];
+    a.accumulation[p] = prev.accumulation[p];
+    a.psqtAccumulation[p] = prev.psqtAccumulation[p];
