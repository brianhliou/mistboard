+void AccumulatorStack::evaluate(const Position& pos, const FeatureTransformer& ft,
+                                 AccumulatorCaches& caches) noexcept {
+    for (Color p : {WHITE, BLACK}) {
+        usize base = size - 1;
+        while (!accumulators[base].computed[p]) {
+            if (base == 0 || PSQFeatureSet::requires_refresh(accumulators[base].dirtyPiece, p)) {
+                refresh(p, pos, ft, caches);
+                break;
+            }
+            --base;
+        }
+        if (!latest().computed[p])
+            for (usize i = base + 1; i < size; ++i) update(p, pos, ft, i - 1, i);
     }
