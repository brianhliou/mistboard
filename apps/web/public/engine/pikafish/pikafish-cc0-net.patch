+void AccumulatorStack::refresh(Color p, const Position& pos, const FeatureTransformer& ft,
+                               AccumulatorCaches& caches) noexcept {
+    Square king = pos.king_square(p);
+    int bucket = PSQFeatureSet::KingBuckets[king];
+    auto& entry = caches[bucket][p];
+    // Compare cached board to current board; the cache key fixes the feature king bucket.
+    Bitboard changed = entry.pieceBB | pos.pieces();
+    while (changed) {
+        Square s = pop_lsb(changed);
+        Piece old = entry.pieces[s], pc = pos.piece_on(s);
+        if (old == pc) continue;
+        if (old != NO_PIECE)
+            apply(entry, ft, PSQFeatureSet::make_index(p, s, old, king), -1);
+        if (pc != NO_PIECE)
+            apply(entry, ft, PSQFeatureSet::make_index(p, s, pc, king), 1);
+        entry.pieces[s] = pc;
     }
