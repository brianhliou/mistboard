{
  "name": "@mistboard/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "dev:agent": "vite --host 0.0.0.0 --port ${PORT:-3099} --strictPort",
    "build": "tsc -p tsconfig.json && vite build && node scripts/prerender-articles.mjs",
    "test": "node scripts/learn-interface-smoke.mjs",
    "test:dark-xiangqi:persistent": "node scripts/dark-xiangqi-persistent-smoke.mjs",
    "test:unit": "vitest run",
    "test:parked": "MISTBOARD_TEST_PARKED=1 vitest run",
    "video:frames": "tsx src/video/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:check": "node scripts/app-i18n-check.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "i18n:prune": "node scripts/prune-article-i18n.mjs",
    "predev": "node ../../scripts/ensure-packages-built.mjs",
    "pretypecheck": "node ../../scripts/ensure-packages-built.mjs",
    "pretest:unit": "node ../../scripts/ensure-packages-built.mjs",
    "pretest": "node ../../scripts/ensure-packages-built.mjs"
  },
  "dependencies": {
    "@mistboard/game": "0.0.0",
    "chessground": "^9.2.1",
    "lucide": "^1.40.0",
    "posthog-js": "^1.426.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "happy-dom": "^20.13.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
