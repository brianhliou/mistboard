{
  "name": "@mistboard/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:persistent": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=8 dist/*.test.js dist/variant-tenant/*.test.js dist/routes/*.test.js dist/bot-match/*.test.js",
    "test:persistent": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/*.test.js dist/variant-tenant/*.test.js dist/routes/*.test.js dist/bot-match/*.test.js",
    "test:unit": "tsx --test --test-concurrency=4 src/*.test.ts src/variant-tenant/*.test.ts src/routes/*.test.ts src/bot-match/*.test.ts --test-name-pattern='^(?!persistence)'",
    "test:parked": "tsx --test --test-concurrency=4 'src/**/*.parkedtest.ts'",
    "test:integration": "node scripts/integration-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p integration/tsconfig.json && tsc -p loadtest/tsconfig.json",
    "loadtest": "tsx loadtest/cli.ts",
    "og:default": "tsx src/scripts/generate-default-og.ts",
    "readme:hero": "tsx src/scripts/generate-xiangqi-hero.ts",
    "migrate": "tsx src/migrate.ts",
    "seed:profiles": "node scripts/seed-profile-fixtures.mjs",
    "seed:qa-fixtures": "node scripts/seed-qa-fixtures.mjs",
    "seed:watch": "tsx src/import-corpus.ts --dir ../web/public/replay-samples --corpus local-watch-fixture --white-name \"Mistboard Engine (white)\" --black-name \"Mistboard Engine (black)\" --mode eve",
    "generate:variant-fixtures": "tsx src/generate-variant-fixtures.ts",
    "seed:variant-fixtures": "tsx src/seed-variant-fixtures.ts",
    "import:xiangqi-broadcast": "tsx src/import-xiangqi-broadcast.ts",
    "backfill:xiangqi-broadcast-translations": "tsx src/backfill-xiangqi-broadcast-translations.ts",
    "import:historical-xiangqi": "tsx src/import-historical-xiangqi.ts",
    "import:elephantchess-xiangqi": "tsx src/import-elephantchess-xiangqi.ts",
    "pilot:elephantchess-manifest": "tsx src/generate-elephantchess-pilot-manifest.ts",
    "pilot:elephantchess-run:init": "tsx src/initialize-elephantchess-pilot-run.ts",
    "pilot:elephantchess-status": "tsx src/xiangqi-puzzle-mining-status.ts",
    "pilot:elephantchess-quality": "tsx src/report-elephantchess-puzzle-quality.ts",
    "readout:mistboard": "tsx src/report-mistboard-readout.ts",
    "pilot:elephantchess-review:export": "tsx src/xiangqi-puzzle-editorial-export.ts",
    "pilot:elephantchess-publish": "tsx src/publish-elephantchess-puzzles.ts",
    "poll:xiangqi-broadcast": "tsx src/poll-xiangqi-broadcast-source.ts",
    "simulate:xiangqi-broadcast": "tsx src/simulate-xiangqi-broadcast.ts",
    "source:xiangqi-broadcast": "tsx src/serve-xiangqi-broadcast-source.ts",
    "import-corpus": "tsx src/import-corpus.ts",
    "engine:enqueue": "tsx src/enqueue-engine-games.ts",
    "engine:enqueue-smoke": "tsx src/enqueue-engine-smoke.ts",
    "engine:enqueue-tournament": "tsx src/enqueue-engine-tournament.ts",
    "engine:bot-rating-import": "tsx src/bot-rating-import.ts",
    "engine:bot-rating-promote": "tsx src/bot-rating-promote.ts",
    "engine:bot-rating-snapshots": "tsx src/bot-rating-snapshots.ts",
    "engine:elo-report": "tsx src/engine-elo-report.ts",
    "engine:queue-status": "tsx src/engine-queue-status.ts",
    "accounts:count": "tsx src/accounts-count.ts",
    "accounts:list": "tsx src/accounts-list.ts",
    "engine:tournament-status": "tsx src/engine-tournament-status.ts",
    "ops:test-engine-alert": "node --import tsx src/engine-alert-email-cli.ts",
    "worker": "node dist/worker.js",
    "worker:execute": "node dist/worker.js --execute",
    "worker:service": "node dist/worker.js --execute --loop",
    "worker:dev": "tsx src/worker.ts",
    "worker:dev:execute": "tsx src/worker.ts --execute",
    "worker:dev:service": "tsx src/worker.ts --execute --loop",
    "predev": "node ../../scripts/ensure-packages-built.mjs",
    "predev:persistent": "node ../../scripts/ensure-packages-built.mjs",
    "pretypecheck": "node ../../scripts/ensure-packages-built.mjs",
    "pretest:unit": "node ../../scripts/ensure-packages-built.mjs",
    "pretest": "node ../../scripts/ensure-packages-built.mjs && node ../../scripts/prune-orphan-dist.mjs .",
    "pretest:persistent": "node ../../scripts/ensure-packages-built.mjs && node ../../scripts/prune-orphan-dist.mjs .",
    "pretest:integration": "node ../../scripts/ensure-packages-built.mjs",
    "build:xiangqi-explorer": "tsx src/build-xiangqi-explorer.ts",
    "rehash:historical-xiangqi": "tsx src/rehash-historical-xiangqi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@mistboard/board-render": "0.0.0",
    "@mistboard/game": "0.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "jose": "^6.2.10",
    "obscenity": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pinyin-pro": "^3.29.3",
    "serve-handler": "^6.1.7",
    "stripe": "^22.6.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/serve-handler": "^6.1.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
