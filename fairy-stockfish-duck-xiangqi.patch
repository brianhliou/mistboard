diff --git a/src/movegen.cpp b/src/movegen.cpp
index a7b6a9f..b92ed24 100644
--- a/src/movegen.cpp
+++ b/src/movegen.cpp
@@ -405,6 +405,42 @@ namespace {
         moveList = generate_pawn_moves<Us, Type>(pos, moveList, target);
         for (PieceSet ps = pos.piece_types() & ~(piece_set(PAWN) | KING); ps;)
             moveList = generate_moves<Us, Type>(pos, moveList, pop_lsb(ps), target);
+
+        // MISTBOARD PATCH (Duck Xiangqi): the flying general, as a real CAPTURE.
+        //
+        // Xiangqi's generals bear on each other down a clear file. Upstream
+        // expresses that as a prohibition in legal(), which is correct while
+        // the general is ROYAL, because then facing is self-check. A variant
+        // whose general is NOT royal has no check to appeal to - Duck Xiangqi
+        // is one, since `wallingRule = duck` refuses a royal king - and there
+        // the same fact has to be expressed the other way round: the attack is
+        // a move, and the game ends when it is played.
+        //
+        // Guarded on count<KING>() so the two readings never both apply. A
+        // royal-king variant (standard xiangqi, janggi) keeps the prohibition
+        // in legal() and never reaches this; only a non-royal general gets the
+        // capture. Restricted to the FILE rather than taking rook attacks
+        // whole: the rank is not part of the rule, and although two palaces on
+        // a 9x10 board can never share a rank, a variants.ini is free to put
+        // them somewhere that can.
+        //
+        // pieces() includes wall squares, so a duck standing on the file
+        // blocks this exactly as a piece does, which is the whole reason the
+        // duck is worth placing there.
+        if (pos.variant()->flyingGeneral && Type != QUIETS && Type != QUIET_CHECKS
+            && !pos.count<KING>(Us))
+        {
+            PieceType gtUs = pos.general_type(Us), gtThem = pos.general_type(~Us);
+            if (pos.pieces(Us, gtUs) && pos.pieces(~Us, gtThem))
+            {
+                Square gfrom = lsb(pos.pieces(Us, gtUs));
+                Bitboard b =  attacks_bb(Us, ROOK, gfrom, pos.pieces())
+                            & file_bb(file_of(gfrom))
+                            & pos.pieces(~Us, gtThem);
+                if (b)
+                    *moveList++ = make_move(gfrom, lsb(b));
+            }
+        }
         // generate drops
         if (pos.piece_drops() && Type != CAPTURES && (pos.can_drop(Us, ALL_PIECES) || pos.two_boards()))
             for (PieceSet ps = pos.piece_types(); ps;)
