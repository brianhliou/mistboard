+// MISTBOARD PATCH (Duck Xiangqi): which piece is acting as the general.
+// Normally the royal KING; in a variant that cannot have one - `wallingRule =
+// duck` forbids royal kings - it is the sole extinction piece type. Returning
+// KING when the answer is ambiguous keeps every other variant unchanged.
+inline PieceType Position::general_type(Color c) const {
+  if (count<KING>(c)) return KING;
+  PieceSet ps = extinction_piece_types();
+  if (ps && (uint64_t(ps) & (uint64_t(ps) - 1)) == 0) return pop_lsb(ps);
+  return KING;
+}
+
 inline bool Position::extinction_single_piece() const {
   assert(var != nullptr);
   return   var->extinctionValue == -VALUE_MATE
diff --git a/src/types.h b/src/types.h
index 844d195..b9a10a6 100644
--- a/src/types.h
+++ b/src/types.h
@@ -239,8 +239,19 @@ constexpr int MAX_PLY = 60;
 #endif
 /// endif USE_HEAP_INSTEAD_OF_STACK_FOR_MOVE_LIST
 #else
-constexpr int MAX_MOVES = 1024;
-constexpr int MAX_PLY = 246;
+// MISTBOARD PATCH (Duck Xiangqi): 1024 is far too small for a walling variant
+// on a 9x10 board. A turn is a piece move AND a duck placement, so the opening
+// array alone generates 2,554 legal moves and random play peaks near 4,901.
+// Overflowing this buffer is a stack smash inside MovePicker (whose `moves`
+// array is a stack member, unlike MoveList which is heap-allocated here), and
+// it presents as a SIGSEGV in MovePicker::next_move with a corrupted backtrace.
+//
+// Upstream raises this to 8192 only under ALLVARS, which is also where the
+// chess duck variant lives - that gate is about branching factor, not curation.
+// MAX_PLY comes down to match: MovePicker is 8192 * 8 = 64KB per ply, and the
+// thread stack is TH_STACK_SIZE = 8MB, so 246 plies would need 15.7MB.
+constexpr int MAX_MOVES = 8192;
+constexpr int MAX_PLY = 100;
 #endif
 /// endif ALLVARS
 
