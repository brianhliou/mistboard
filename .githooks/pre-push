#!/bin/sh
set -eu

# Allows production pushes only through release:prod, then runs its path-aware
# local gate when release:prod was asked to skip its own ci:quick pass.
# Catches the failure modes that bit us on 2026-05-13: a new internal
# workspace missing from scripts/build.mjs' order (board-render), and an
# entrypoint refactor that broke a spawn-based test (privacy-ws).
#
# Only runs for pushes that update refs/heads/main.

# git feeds pre-push hooks one line per ref on stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
pushing_main=0
main_local_sha=
main_remote_sha=
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      pushing_main=1
      main_local_sha="$_local_sha"
      main_remote_sha="$_remote_sha"
      ;;
  esac
done

if [ "$pushing_main" != "1" ]; then
  exit 0
fi

if [ "${MISTBOARD_RELEASE_PUSH:-}" != "1" ] && [ "${SKIP_PREPUSH:-}" != "1" ]; then
  echo "pre-push: direct pushes to main are disabled."
  echo "Use: npm run release:prod -- --push  (drains only when games are live)."
  echo "Emergency bypass: SKIP_PREPUSH=1 git push  (still runs the path-aware gate)."
  exit 1
fi

# release:prod has just observed a completed green hosted CI run for this
# exact SHA. Keep the hook enabled without repeating the local gate while
# production is already drained. Other pushes still run the usual gate.
if [ "${MISTBOARD_RELEASE_PUSH:-}" = "1" ] \
  && [ "${MISTBOARD_RELEASE_CI_VERIFIED:-}" = "$main_local_sha" ]; then
  echo "pre-push: release candidate passed hosted CI at $main_local_sha"
  exit 0
fi

node scripts/pre-push-check.mjs "$main_local_sha" "$main_remote_sha"
