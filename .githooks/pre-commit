#!/bin/sh
set -eu

if [ "${SKIP_PRECOMMIT:-}" = "1" ]; then
  echo "pre-commit: skipped via SKIP_PRECOMMIT=1"
  exit 0
fi

unstaged_paths=$(git diff --name-only)
untracked_paths=$(git ls-files --others --exclude-standard)

print_paths() {
  label=$1
  paths=$2
  if [ -n "$paths" ]; then
    echo "  $label:" >&2
    printf '%s\n' "$paths" | sed -n '1,20p' | sed 's/^/    /' >&2
  fi
}

if [ -n "$unstaged_paths" ] || [ -n "$untracked_paths" ]; then
  if [ "${MISTBOARD_PRECOMMIT_STASH:-}" != "1" ]; then
    echo "pre-commit: unstaged or untracked files are present." >&2
    echo "pre-commit: refusing to auto-stash. A repo-wide stash can clobber a concurrent session, and has lost newly-ignored files on .gitignore-flip commits." >&2
    print_paths "unstaged" "$unstaged_paths"
    print_paths "untracked" "$untracked_paths"
    echo "Get to a clean tree instead:" >&2
    echo "  - stage what belongs in THIS commit (git add <paths>), or" >&2
    echo "  - let the other session commit first, then commit yours, or" >&2
    echo "  - run long work in a per-session worktree (npm run worktree:new)." >&2
    echo "MISTBOARD_PRECOMMIT_STASH=1 forces one stash+commit: solo, clean-ish trees only, never a .gitignore-flip. Not the default fix." >&2
    exit 1
  fi

  stash_created=0
  restore_stash() {
    if [ "$stash_created" = "1" ]; then
      git stash pop --quiet || {
        echo "pre-commit: failed to restore unstaged changes from stash." >&2
        echo "Resolve manually with: git stash list && git stash pop" >&2
        exit 1
      }
    fi
  }
  trap restore_stash EXIT INT TERM

  # No --include-untracked: sweeping untracked files repo-wide is what clobbers
  # concurrent sessions and loses newly-ignored files on .gitignore-flip commits.
  # Only unstaged TRACKED changes are set aside; --keep-index preserves staged.
  git stash push --quiet --keep-index \
    -m "pre-commit unstaged backup"
  stash_created=1
fi

# Biome first: about a second, and it is what the release gate fails on most
# often (a format-only fix costs a push, a CI run and a deploy). --staged reads
# the staged paths, whose working copies match the index here: the tree is
# clean, or the --keep-index stash above set the unstaged edits aside.
# --no-errors-on-unmatched: a commit with no Biome-handled files passes.
if ! npm run lint -- --staged --no-errors-on-unmatched; then
  echo "pre-commit: Biome found formatting or lint problems in the staged files." >&2
  echo "pre-commit: npm run lint:fix fixes formatting; re-stage the files and commit again." >&2
  exit 1
fi

npm run typecheck --workspaces --if-present
