{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/apps/server/**",
      "!/apps/server/src/**/*.test.ts",
      "!/apps/server/src/test-builders.ts",
      "!/apps/server/src/persistence-test-support.ts",
      "!/apps/server/integration/**",
      "!/apps/server/loadtest/**",
      "!/apps/server/scripts/**",
      "/packages/game/**",
      "/packages/board-render/**",
      "/stockfish.ref",
      "/fairy-stockfish-xiangqi.ref",
      "/fairy-stockfish-duck-xiangqi.ref",
      "/fairy-stockfish-duck-xiangqi.patch",
      "/fairy-stockfish-atomic-xiangqi.ref",
      "/fairy-stockfish-atomic-xiangqi.patch",
      "/pikafish-jieqi.ref",
      "/pikafish.ref",
      "/scripts/engine-assets.sh",
      "/engine.ref",
      "/scripts/build.mjs",
      "/scripts/start.mjs",
      "/package.json",
      "/package-lock.json",
      "/railpack.json",
      "/railway.engine-worker.json",
      "/tsconfig.base.json"
    ]
