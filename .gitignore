node_modules
dist
.env
.env.*
!.env.example
*.log
.DS_Store
apps/web/.vite
apps/web/.video-out
apps/web/.video-cache
.venv
__pycache__
*.egg-info
research/python-fow-lab/corpora/*/games/
research/python-fow-lab/corpora/*/views/
research/python-fow-lab/feedback/
research/python-fow-lab/fow_rust/target/
research/python-fow-lab/fow_rust/Cargo.lock
research/python-fow-lab/lab/runs/
research/python-fow-lab/.pytest_cache/
research/python-fow-lab/**/__pycache__/
research/python-fow-lab/uv.lock
research/python-fow-lab/vendor/

# Local generated distillation corpora and model checkpoints. Keep reviewed
# findings in docs or docs-private before deleting local runs.
research/python-fow-lab/distill/

# Local-only symlink for the ?bakeoff browser route. Points at a bake-off
# output directory under /tmp; not part of the repo.
apps/web/public/bakeoff

# Engine/lab bakeoff exports belong in the private mistboard-engine repo.
lab-exports/

# Versioned bake-off output dirs (per Tier-1 release). These are ignored
# because they are large local artifacts, not because they are disposable.
# If a run produces annotations, screenshots, hard-fact findings, or build-log
# evidence, archive/inventory it under docs-private/engine-track before deleting
# a worktree or reusing the save dir.
apps/web/public/bakeoff-*

# Belief-replay captures (engine-v2 belief-set enumeration) are engine internals.
# The viewer + captures now live in the private mistboard-engine repo (viewer/);
# this guard keeps them from being re-introduced into the public build.
apps/web/public/belief-replays/

# Tournament run output dirs (timestamped per-run game logs + manifests,
# multi-MB each). Local-only artifact; archive/inventory meaningful runs before
# cleanup.
research/python-fow-lab/tournaments/

# Private founder/operator notes. Public docs should be contributor-safe.
docs-private/
.claude/

# Agent-instruction layer is local-only as of 2026-06-01. Keeping CLAUDE.md
# (Claude Code) and AGENTS.md (Codex) unpublished frees them from the
# public-safe constraint so they can hold real operating detail. Both still
# load from disk every session; only publication stops. Anchored to repo root
# so the docs-private/ draft and any nested copies are unaffected.
/CLAUDE.md
/AGENTS.md

# Repo uses npm, not pnpm. Stray pnpm-lock files are accidental artifacts.
pnpm-lock.yaml

# AI-generated pixel-art + animation experiments. Large (~100MB), reproducible
# from prompts via scripts/pixel-gen.mjs and scripts/video-gen.mjs. The
# DEV-only /pixel-lab page references these assets; regenerate locally with
# REPLICATE_API_TOKEN + OPENAI_API_KEY to view them.
apps/web/public/pixel-lab/
apps/web/public/pixel-lab-assets/

# Local scratch dir: mobile-test screenshots (scripts/mobile-loop.mjs) and
# other dev-loop output (e.g. web-port.txt). Never part of the repo.
tmp/
apps/server/.engine-bakeoff-deploy-nonce

# Private distribution pipeline and generated media output. This repo is public,
# so keep campaign tooling, generated PNG/MP4/JSON batches, and local storyboards
# out of git unless the distribution track is intentionally opened later.
distribution-artifacts/
scripts/distribution/

# Playwright MCP scratch output (page snapshots written by the browser tool
# during agent sessions). Never part of the repo.
.playwright-mcp/

# Xiangqi puzzle-miner sidecars (JSONL + metrics from scripts/variant-lab/
# xiangqi-puzzle-miner.ts). Local mining artifacts; the reviewed output is the
# emitted packages/game/src/puzzles-xiangqi-mined.ts module.
scripts/variant-lab/out/

# Win-curve calibration corpus: re-harvestable third-party game records, not
# redistributed here. The derived samples (scripts/data/win-curve-samples.json)
# are what the fit needs and those ARE tracked. See scripts/calibrate-win-curve.mjs.
scripts/data/win-curve-corpus/

# Bundled output of scripts/build-benedict-diagrams.mjs
.benedict-diagrams.mjs
scripts/.benedict-diagrams.mjs

# Locally built engine binaries. `./bin/<name>` is the cwd-relative dev twin of
# the container's `/app/bin/<name>`, and every FSF path resolver looks there
# (see xiangqi-fsf-engine.ts, uci-engine-harness.ts), so following the documented
# dev path drops a ~47MB binary into `git add -A` range. The container builds its
# own copy from the pinned refs; nothing here is ever committed.
/bin/
